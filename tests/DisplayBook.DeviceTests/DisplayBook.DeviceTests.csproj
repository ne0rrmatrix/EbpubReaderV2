<Project Sdk="Microsoft.NET.Sdk">

	<!-- Device tests: a MAUI app that runs xUnit tests on the device itself, so code that calls MAUI
	     platform APIs (FileSystem, SecureStorage, Preferences) runs against the real implementations
	     instead of being left out of DisplayBook.Tests. Modelled on CommunityToolkit.Maui's
	     device-test project (CommunityToolkit/Maui#3344), using the DeviceRunners packages
	     (the public NuGet form of dotnet/maui's device-test runner) rather than vendoring that runner.
	     See README.md. -->

	<PropertyGroup>
		<TargetFrameworks>$(NetVersion)-ios;$(NetVersion)-android;$(NetVersion)-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(NetVersion)-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>DisplayBook.DeviceTests</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<IsPackable>false</IsPackable>
		<!-- An Exe that isn't an IsTestProject, so SonarQube Cloud has to be told this is test code. -->
		<SonarQubeTestProject>true</SonarQubeTestProject>
		<!-- The MAUI app supplies its own entry points; dotnet test reaches it through
		     DeviceRunners.Testing.Targets, not Microsoft.Testing.Platform. -->
		<GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
		<!-- Seconds without a test result before dotnet test treats the app as crashed. The page tests
		     wait up to a minute for a cold WebView to open a book, so the default of 30 is too short. -->
		<DeviceRunnersDataTimeout>300</DeviceRunnersDataTimeout>

		<ApplicationTitle>DisplayBook Device Tests</ApplicationTitle>
		<!-- Must differ from DisplayBook.App's ApplicationId: it decides the app-data folder and the
		     secure-storage scope, and the tests wipe both (see AppDataSandbox). -->
		<ApplicationId>com.ahdf.displaybook.devicetests</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Unpackaged like DisplayBook.App, so dotnet test launches the built .exe directly. -->
		<WindowsPackageType>None</WindowsPackageType>
		<!-- Bundle the Windows App SDK runtime so the app also runs on machines without it installed
		     (the GitHub-hosted runner in .github/workflows/build.yml). -->
		<WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DisplayBook.Viewer\DisplayBook.Viewer.csproj" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="..\..\src\DisplayBook.App\Resources\AppIcon\appicon.svg" ForegroundFile="..\..\src\DisplayBook.App\Resources\AppIcon\appiconfg.svg" Color="#14213D" />
		<MauiSplashScreen Include="..\..\src\DisplayBook.App\Resources\Splash\splash_icon.svg" Color="#14213D" BaseSize="256,256" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Zeroconf" Version="3.7.16" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.utility" Version="2.9.3" />
		<PackageReference Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.VisualRunners.Xunit" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.UITesting.Maui" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.UITesting.Xunit" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.12" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<AppSource>..\..\src\DisplayBook.App\</AppSource>
		<AppSourceExcludes>$(AppSource)obj\**;$(AppSource)bin\**;$(AppSource)Platforms\**</AppSourceExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!-- All of DisplayBook.App is compiled in (it is an Exe with its own entry points, so it can't be
		     referenced), so pages, view models and services can all be tested against real MAUI.
		     Linked files keep their paths under App\, which the XAML's relative Source= paths rely on.
		     Platform-specific files are added per target framework below; Directory.Build.targets'
		     filename filters only apply to files inside this project's own folder. -->
		<Compile Include="$(AppSource)**\*.cs" Exclude="$(AppSourceExcludes);$(AppSource)**\*.android.cs;$(AppSource)**\*.macios.cs;$(AppSource)**\*.windows.cs" LinkBase="App" />
		<MauiXaml Include="$(AppSource)**\*.xaml" Exclude="$(AppSourceExcludes)" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiFont Include="$(AppSource)Resources\Fonts\*" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Compile Include="$(AppSource)**\*.windows.cs" Exclude="$(AppSourceExcludes)" LinkBase="App" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Compile Include="$(AppSource)**\*.android.cs" Exclude="$(AppSourceExcludes)" LinkBase="App" />
		<!-- The app's own MainActivity is this app's launcher activity too: ReaderPage and the
		     Android book picker cast Platform.CurrentActivity to it. -->
		<Compile Include="$(AppSource)Platforms\Android\MainActivity.cs" Link="App\Platforms\Android\MainActivity.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<Compile Include="$(AppSource)**\*.macios.cs" Exclude="$(AppSourceExcludes)" LinkBase="App" />
	</ItemGroup>

	<ItemGroup>
		<!-- The metadata API responses DisplayBook.Tests already uses, served by the fake network. -->
		<EmbeddedResource Include="..\DisplayBook.Tests\Fixtures\BookMetadata\*.json" LogicalName="BookMetadata.%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Test classes are found by reflection, which the trimmer cannot see. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="$(AssemblyName)" RootMode="all" />
	</ItemGroup>

</Project>
