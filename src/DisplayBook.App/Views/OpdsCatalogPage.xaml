<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DisplayBook.App.ViewModels"
             x:Class="DisplayBook.App.Views.OpdsCatalogPage"
             x:DataType="vm:OpdsCatalogViewModel"
             Title="OPDS catalog">
    <Grid RowDefinitions="Auto,*,Auto" Padding="{OnIdiom Phone='16,8,16,16', Default='24,16,24,24'}">
        <VerticalStackLayout Grid.Row="0" Spacing="16">
            <Button Text="‹  Servers"
                    Command="{Binding NavigateBackCommand}"
                    HorizontalOptions="Start"
                    Background="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource LibraryBackLight}, Dark={StaticResource LibraryBackDark}}"
                    Padding="0"
                    AutomationId="CatalogBackButton" />
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}"
                       FontSize="28"
                       FontAttributes="Bold"
                       AutomationId="CatalogTitle" />
                <Label Text="{Binding Subtitle}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
            </VerticalStackLayout>
            <Label Text="{Binding CrumbsText}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                   IsVisible="{Binding CanGoBack}"
                   AutomationId="BreadcrumbLabel" />
            <Grid IsVisible="{Binding CanSearch}"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  AutomationId="SearchRow">
                <Entry x:Name="SearchEntry"
                       Placeholder="Search this catalog…"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       Keyboard="Text"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Completed="OnSearchEntryCompleted"
                       AutomationId="SearchEntry" />
                <Button Grid.Column="1"
                        Text="Search"
                        Command="{Binding SearchCommand}"
                        Background="{AppThemeBinding Light={StaticResource LibraryAccent}, Dark={StaticResource LibraryAccent}}"
                        TextColor="{StaticResource White}"
                        MinimumHeightRequest="44"
                        AutomationId="SearchButton" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}"
                                HorizontalOptions="Center"
                                WidthRequest="28"
                                HeightRequest="28"
                                AutomationId="CatalogLoadingIndicator" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1"
                        x:Name="EntriesCollection"
                        ItemsSource="{Binding Entries}"
                        AutomationId="EntriesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogEntryModel">
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Grid.GestureRecognizers>
                            <Border Background="{AppThemeBinding Light={StaticResource LibraryCardLight}, Dark={StaticResource LibraryCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12"
                                    Margin="0,4">
                                <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                    <Border WidthRequest="72"
                                            HeightRequest="72"
                                            VerticalOptions="Center"
                                            Background="{AppThemeBinding Light={StaticResource LibraryCoverLight}, Dark={StaticResource LibraryCoverDark}}">
                                        <Grid>
                                            <Label Text="📖"
                                                   FontSize="28"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding CoverUrl}"
                                                   Aspect="Fill"
                                                   IsVisible="{Binding HasCover}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="12" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                <Button Text="← Previous"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource LibraryAccent}, Dark={StaticResource LibraryBackDark}}"
                        AutomationId="PrevPageButton" />
                <Button Grid.Column="1"
                        Text="Next →"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource LibraryAccent}, Dark={StaticResource LibraryBackDark}}"
                        AutomationId="NextPageButton" />
            </Grid>
            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}"
                   AutomationId="CatalogStatus" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
