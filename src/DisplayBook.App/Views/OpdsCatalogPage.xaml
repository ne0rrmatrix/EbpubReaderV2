<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DisplayBook.App.ViewModels"
             xmlns:conv="clr-namespace:DisplayBook.App.Views"
             x:Class="DisplayBook.App.Views.OpdsCatalogPage"
             x:DataType="vm:OpdsCatalogViewModel"
             Title="OPDS catalog">
    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:StringNotNullConverter x:Key="StringNotNull" />

        <DataTemplate x:Key="BookCardTemplate" x:DataType="vm:CatalogEntryModel">
            <Border Background="{AppThemeBinding Light={StaticResource LibraryCardLight}, Dark={StaticResource LibraryCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="180,Auto,Auto" RowSpacing="4">
                    <Border Grid.Row="0"
                            Background="{AppThemeBinding Light={StaticResource LibraryCoverLight}, Dark={StaticResource LibraryCoverDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            Padding="0">
                        <Grid>
                            <Label Text="📖"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasCover, Converter={StaticResource InverseBool}}" />
                            <Image Source="{Binding CoverUrl}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   IsVisible="{Binding HasCover}"
                                   SemanticProperties.Description="{Binding Title}" />
                        </Grid>
                    </Border>
                    <Label Grid.Row="1"
                           Text="{Binding Title}"
                           FontAttributes="Bold"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="2" />
                    <Label Grid.Row="2"
                           Text="{Binding Subtitle}"
                           FontSize="10"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NavigationCardTemplate" x:DataType="vm:CatalogEntryModel">
            <Border Background="{AppThemeBinding Light={StaticResource LibraryCardLight}, Dark={StaticResource LibraryCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    VerticalOptions="Fill">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="📂"
                           FontSize="24"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding Title}"
                           FontAttributes="Bold"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="2" />
                    <Label Text="{Binding Subtitle}"
                           FontSize="10"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           IsVisible="{Binding Subtitle, Converter={StaticResource StringNotNull}}"
                           TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <conv:CatalogEntryTemplateSelector x:Key="EntryTemplateSelector"
                                            BookTemplate="{StaticResource BookCardTemplate}"
                                            NavigationTemplate="{StaticResource NavigationCardTemplate}" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*,Auto" Padding="{OnIdiom Phone='10,6,10,10', Default='16,10,16,16'}">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="‹  Servers"
                    Command="{Binding NavigateBackCommand}"
                    HorizontalOptions="Start"
                    Background="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource LibraryBackLight}, Dark={StaticResource LibraryBackDark}}"
                    Padding="0"
                    AutomationId="CatalogBackButton" />
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Title}"
                       FontSize="18"
                       FontAttributes="Bold"
                       AutomationId="CatalogTitle" />
                <Label Text="{Binding Subtitle}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
            </VerticalStackLayout>
            <Label Text="{Binding CrumbsText}"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                   IsVisible="{Binding CanGoBack}"
                   AutomationId="BreadcrumbLabel" />
            <Grid IsVisible="{Binding CanSearch}"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  AutomationId="SearchRow">
                <Entry x:Name="SearchEntry"
                       Placeholder="Search this catalog…"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       Keyboard="Text"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Completed="OnSearchEntryCompleted"
                       AutomationId="SearchEntry" />
                <Button Grid.Column="1"
                        Text="Search"
                        Command="{Binding SearchCommand}"
                        Background="{AppThemeBinding Light={StaticResource LibraryAccent}, Dark={StaticResource LibraryAccent}}"
                        TextColor="{StaticResource White}"
                        AutomationId="SearchButton" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}"
                                HorizontalOptions="Center"
                                WidthRequest="22"
                                HeightRequest="22"
                                AutomationId="CatalogLoadingIndicator" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1"
                        x:Name="EntriesCollection"
                        ItemsSource="{Binding Entries}"
                        ItemTemplate="{StaticResource EntryTemplateSelector}"
                        ItemSizingStrategy="MeasureAllItems"
                        AutomationId="EntriesCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="EntriesLayout"
                                     Orientation="Vertical"
                                     Span="1"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                <Button Text="← Previous"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource LibraryAccent}, Dark={StaticResource LibraryBackDark}}"
                        AutomationId="PrevPageButton" />
                <Button Grid.Column="1"
                        Text="Next →"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource LibraryAccent}, Dark={StaticResource LibraryBackDark}}"
                        AutomationId="NextPageButton" />
            </Grid>
            <Label Text="{Binding StatusMessage}"
                   FontSize="12"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}"
                   AutomationId="CatalogStatus" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
