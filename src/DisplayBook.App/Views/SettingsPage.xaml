<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DisplayBook.App.ViewModels"
             xmlns:conv="clr-namespace:DisplayBook.App.Views"
             x:Class="DisplayBook.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">
    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:StringNotNullConverter x:Key="StringNotNull" />
    </ContentPage.Resources>

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="16"
              Padding="{OnIdiom Phone='16,8,16,16', Default='24,16,24,24'}">

            <Button Grid.Row="0"
                    Text="‹  Library"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    Background="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource LibraryBackLight}, Dark={StaticResource LibraryBackDark}}"
                    Padding="0" />

            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <Label Text="Settings"
                       FontSize="28"
                       FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Sign in to keep your reading position in sync across devices."
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <!-- Signed-in state -->
            <Border Grid.Row="2"
                    IsVisible="{Binding IsSignedIn}"
                    Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sync is on" FontAttributes="Bold" FontSize="16" />
                        <Label AutomationId="SignedInEmailLabel"
                               Text="{Binding CurrentEmail, StringFormat='Signed in as {0}'}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Button AutomationId="SignOutButton"
                                Text="Sign out"
                                Command="{Binding SignOutCommand}"
                                Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                TextColor="{AppThemeBinding Light={StaticResource OffBlack}, Dark={StaticResource White}}"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <!-- Verify email (required before TOTP enrollment) -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowVerifyEmailPrompt}">
                        <Label Text="Two-factor authentication" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Verify your email address to turn on two-factor authentication."
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Button AutomationId="SendVerificationEmailButton"
                                Text="Send verification email"
                                Command="{Binding SendVerificationEmailCommand}"
                                Background="{StaticResource LibraryAccent}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold" />
                        <Button AutomationId="RefreshSecurityStateButton"
                                Text="I've verified — refresh"
                                Command="{Binding RefreshSecurityStateCommand}"
                                Background="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Start TOTP enrollment -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowStartTotpEnrollment}">
                        <Label Text="Two-factor authentication" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Add an authenticator app (Google Authenticator, Authy, etc.) for an extra sign-in step."
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Button AutomationId="StartTotpEnrollmentButton"
                                Text="Set up authenticator app"
                                Command="{Binding StartTotpEnrollmentCommand}"
                                Background="{StaticResource LibraryAccent}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- In-progress TOTP enrollment: show secret, ask for a code -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEnrollingTotp}">
                        <Label Text="Set up authenticator app" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Add this key to your authenticator app, then enter the 6-digit code it shows."
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label AutomationId="TotpSecretLabel"
                               Text="{Binding TotpSecret}"
                               FontFamily="OpenSansSemibold"
                               LineBreakMode="CharacterWrap" />
                        <Button AutomationId="CopyTotpSecretButton"
                                Text="Copy key"
                                Command="{Binding CopyTotpSecretCommand}"
                                Background="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="40"
                                FontAttributes="Bold" />
                        <Entry AutomationId="TotpCodeEntry"
                               Placeholder="6-digit code"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                               Keyboard="Numeric"
                               Text="{Binding TotpCode, Mode=TwoWay}" />
                        <Button AutomationId="ConfirmTotpEnrollmentButton"
                                Text="Confirm"
                                Command="{Binding ConfirmTotpEnrollmentCommand}"
                                Background="{StaticResource LibraryAccent}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold" />
                        <Button AutomationId="CancelTotpEnrollmentButton"
                                Text="Cancel"
                                Command="{Binding CancelTotpEnrollmentCommand}"
                                Background="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                CornerRadius="12"
                                HeightRequest="40" />
                    </VerticalStackLayout>

                    <!-- TOTP already enrolled -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowTotpEnrolledStatus}">
                        <Label Text="Two-factor authentication is on" FontAttributes="Bold" FontSize="16" />
                        <Button AutomationId="RemoveTotpEnrollmentButton"
                                Text="Remove"
                                Command="{Binding RemoveTotpEnrollmentCommand}"
                                Background="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}"
                                BorderColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}"
                                BorderWidth="1"
                                CornerRadius="12"
                                HeightRequest="44" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Signed-out state: plain email/password form -->
            <Border Grid.Row="2"
                    IsVisible="{Binding ShowSignInForm}"
                    Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sign in or create an account" FontAttributes="Bold" FontSize="16" />
                    <Entry AutomationId="EmailEntry"
                           Placeholder="Email"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           Keyboard="Email"
                           Text="{Binding Email, Mode=TwoWay}" />
                    <Entry AutomationId="PasswordEntry"
                           Placeholder="Password"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           IsPassword="True"
                           Text="{Binding Password, Mode=TwoWay}" />
                    <Button AutomationId="SignInButton"
                            Text="Sign in"
                            Command="{Binding SignInCommand}"
                            Background="{StaticResource LibraryAccent}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                    <Button AutomationId="SignUpButton"
                            Text="Create account"
                            Command="{Binding SignUpCommand}"
                            Background="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            BorderWidth="1"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                    <ActivityIndicator AutomationId="SettingsBusyIndicator"
                                       IsRunning="{Binding IsBusy}"
                                       HeightRequest="18"
                                       WidthRequest="18"
                                       HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Mid sign-in: TOTP code required -->
            <Border Grid.Row="2"
                    IsVisible="{Binding IsAwaitingMfaCode}"
                    Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Enter your authenticator code" FontAttributes="Bold" FontSize="16" />
                    <Label Text="This account has two-factor authentication turned on."
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Entry AutomationId="MfaCodeEntry"
                           Placeholder="6-digit code"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           Keyboard="Numeric"
                           Text="{Binding MfaCode, Mode=TwoWay}" />
                    <Button AutomationId="SubmitMfaCodeButton"
                            Text="Verify"
                            Command="{Binding SubmitMfaCodeCommand}"
                            Background="{StaticResource LibraryAccent}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                    <Button AutomationId="CancelMfaButton"
                            Text="Cancel"
                            Command="{Binding CancelMfaCommand}"
                            Background="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                            CornerRadius="12"
                            HeightRequest="40" />
                    <ActivityIndicator AutomationId="MfaBusyIndicator"
                                       IsRunning="{Binding IsBusy}"
                                       HeightRequest="18"
                                       WidthRequest="18"
                                       HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Label Grid.Row="3"
                   AutomationId="SettingsStatus"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNull}}"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}" />
        </Grid>
    </ScrollView>
</ContentPage>
