<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DisplayBook.App.Models"
             xmlns:vm="clr-namespace:DisplayBook.App.ViewModels"
             x:Class="DisplayBook.App.Views.LibraryPage"
             x:Name="Page"
             xmlns:views="clr-namespace:DisplayBook.App.Views"
             x:DataType="vm:LibraryViewModel"
             Title="Library">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="{OnIdiom Phone=16, Default=24}" RowSpacing="16">
        <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}" ColumnSpacing="10">
            <VerticalStackLayout Spacing="4">
                <Label Text="Your library"
                       FontSize="32"
                       FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Choose a book to read"
                       TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                       FontSize="16" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}"
                       Grid.Row="{OnIdiom Phone=1, Default=0}"
                       Spacing="{OnIdiom Phone=4, Default=8}"
                       VerticalOptions="Center"
                       IsVisible="{Binding IsNotSelectionMode}">
            <Button Text="Select"
                Command="{Binding EnterSelectionModeCommand}"
                Background="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                BorderWidth="1"
                CornerRadius="10" />
            <Button Text="Add EPUB"
                Command="{Binding ImportFileCommand}"
                 Background="{StaticResource LibraryAccent}"
                TextColor="White"
                CornerRadius="10" />
            <Button Text="Add folder"
                Command="{Binding ImportFolderCommand}"
                 Background="{StaticResource LibraryAccentLightSurface}"
                 TextColor="{StaticResource LibraryAccent}"
                CornerRadius="10" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}"
                       Grid.Row="{OnIdiom Phone=1, Default=0}"
                       Spacing="{OnIdiom Phone=2, Default=8}"
                       VerticalOptions="Center"
                       IsVisible="{Binding IsSelectionMode}">
            <Label Text="{Binding SelectedCount, StringFormat='{0} selected'}"
                   VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
            <Button Text="Select all"
                Command="{Binding SelectAllCommand}"
                Background="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                Padding="8,0" />
            <Button Text="Clear"
                Command="{Binding ClearSelectionCommand}"
                Background="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                Padding="8,0" />
            <Button Text="Delete"
                Command="{Binding DeleteSelectedCommand}"
                Background="#A83A3A"
                TextColor="White"
                CornerRadius="10" />
            <Button Text="Cancel"
                Command="{Binding ExitSelectionModeCommand}"
                 Background="{StaticResource LibraryAccentLightSurface}"
                 TextColor="{StaticResource LibraryAccent}"
                CornerRadius="10" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}" ColumnSpacing="12">
            <SearchBar Placeholder="Search by title or author"
                   Text="{Binding SearchQuery, Mode=TwoWay}"
                   CancelButtonColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   HorizontalOptions="Fill" />
            <Picker Grid.Column="{OnIdiom Phone=0, Default=1}"
                Grid.Row="{OnIdiom Phone=1, Default=0}"
                Title="Sort library"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SortOption, Mode=TwoWay}"
                WidthRequest="{OnIdiom Phone=-1, Default=190}"
                HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                VerticalOptions="Center" />
        </Grid>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}"
               IsVisible="{Binding HasError}"
               LineBreakMode="WordWrap" />

        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView x:Name="BooksCollection"
                    ItemsSource="{Binding VisibleBooks}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="BooksLayout"
                                     Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="18"
                                     VerticalItemSpacing="24" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryBookItem">
                        <Border Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                                Background="{AppThemeBinding Light={StaticResource LibraryCardLight}, Dark={StaticResource LibraryCardDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource LibrarySelectionStroke}" />
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LibraryCardSelectedLight}, Dark={StaticResource LibraryCardSelectedDark}}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=ViewModel.OpenDetailsCommand, x:DataType=views:LibraryPage}"
                                                      CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="{OnIdiom Phone='300,Auto,Auto', Default='360,Auto,Auto'}" RowSpacing="9">
                                <Grid Grid.Row="0">
                                    <Border Background="{AppThemeBinding Light={StaticResource LibraryCoverLight}, Dark={StaticResource LibraryCoverDark}}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="0">
                                        <Image Source="{Binding CoverPath}"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill"
                                               SemanticProperties.Description="{Binding Title}" />
                                    </Border>
                                    <Border HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="8"
                                            Padding="0"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Background="{StaticResource LibraryAccent}"
                                             IsVisible="{Binding Source={x:Reference Page}, Path=ViewModel.IsSelectionMode, x:DataType=views:LibraryPage}">
                                        <Label Text="✓"
                                               TextColor="White"
                                               FontSize="20"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                                <Label Grid.Row="1"
                                       Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Label Grid.Row="2"
                                       Text="{Binding Author}"
                                        TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="Your library is empty"
                               FontSize="20"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsLibraryEmpty}" />
                        <Label Text="Added books will appear here."
                               TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsLibraryEmpty}" />
                        <Label Text="No books match your search"
                               FontSize="20"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsSearchEmpty}" />
                        <Label Text="Try a different title or author."
                                TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsSearchEmpty}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
        <Grid Grid.RowSpan="4"
              Background="#99000000"
              IsVisible="{Binding IsImporting}"
              ZIndex="10"
              Padding="24">
            <Border Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource LibraryCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="24"
                    MaximumWidthRequest="520"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,84" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4"
                                             HorizontalOptions="Fill">
                            <Label Text="Adding books"
                                   FontSize="24"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding ImportStage}"
                                    TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                                   FontSize="15"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   HeightRequest="24" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding ImportProgressPercent}"
                               FontSize="28"
                               FontAttributes="Bold"
                                TextColor="{StaticResource LibraryAccent}"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center" />
                    </Grid>

                    <ProgressBar Progress="{Binding ImportProgress}"
                                  ProgressColor="{StaticResource LibraryAccent}"
                                  Background="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                                 HeightRequest="10" />

                    <Label Text="{Binding ImportCurrentItem}"
                           FontSize="14"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           HeightRequest="20" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding ImportProgressSummary}"
                                TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Command="{Binding CancelImportCommand}"
                                Background="#A83A3A"
                                TextColor="White"
                                CornerRadius="10"
                                Padding="18,10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
