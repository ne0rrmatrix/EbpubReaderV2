<?xml version="1.0" encoding="utf-8" ?>
<!--
    Variation 2 — "Bold Card Grid"
    Larger, gallery-style covers in a responsive card grid. Bigger cover art,
    stronger title hierarchy, generous spacing. Closest to the current design
    but with a more visual, "bookstore" feel. Fully drop-in (GridItemsLayout).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DisplayBook.App.Models"
             xmlns:vm="clr-namespace:DisplayBook.App.ViewModels"
             xmlns:views="clr-namespace:DisplayBook.App.Views"
             x:Class="DisplayBook.App.Views.LibraryPage"
             x:Name="Page"
             x:DataType="vm:LibraryViewModel"
             Title="Library">

     <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="{OnIdiom Phone=10, Default=16}" RowSpacing="10">

        <!-- Header + primary actions -->
        <Grid ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}" ColumnSpacing="10">
            <VerticalStackLayout Spacing="2">
                <Label Text="Your library"
                       FontSize="18"
                       FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Choose a book to read"
                       TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                       FontSize="12" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}"
                                   Grid.Row="{OnIdiom Phone=1, Default=0}"
                                   Spacing="{OnIdiom Phone=4, Default=6}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsNotSelectionMode}">
                <ImageButton Source="{AppThemeBinding Light=icon_checklist_light.png, Dark=icon_checklist_dark.png}"
                             Command="{Binding EnterSelectionModeCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Select books"
                             ToolTipProperties.Text="Select books" />
                <ImageButton Source="{AppThemeBinding Light=icon_note_add_light.png, Dark=icon_note_add_dark.png}"
                             Command="{Binding ImportFileCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Add EPUB"
                             ToolTipProperties.Text="Add EPUB" />
                <ImageButton Source="{AppThemeBinding Light=icon_create_new_folder_light.png, Dark=icon_create_new_folder_dark.png}"
                             Command="{Binding ImportFolderCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Add folder"
                             ToolTipProperties.Text="Add folder" />
                <ImageButton Source="{AppThemeBinding Light=icon_travel_explore_light.png, Dark=icon_travel_explore_dark.png}"
                             Command="{Binding BrowseOpdsCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Browse OPDS catalogs"
                             ToolTipProperties.Text="Browse OPDS"
                             AutomationId="BrowseOpdsButton" />
                <ImageButton Source="{AppThemeBinding Light=icon_settings_light.png, Dark=icon_settings_dark.png}"
                             Command="{Binding OpenSettingsCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Settings"
                             ToolTipProperties.Text="Settings"
                             AutomationId="SettingsButton" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="{OnIdiom Phone=0, Default=1}"
                                   Grid.Row="{OnIdiom Phone=1, Default=0}"
                                   Spacing="{OnIdiom Phone=2, Default=6}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsSelectionMode}">
                <Label Text="{Binding SelectedCount, StringFormat='{0} selected'}"
                       VerticalOptions="Center"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}" />
                <ImageButton Source="{AppThemeBinding Light=icon_select_all_light.png, Dark=icon_select_all_dark.png}"
                             Command="{Binding SelectAllCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Select all books"
                             ToolTipProperties.Text="Select all" />
                <ImageButton Source="{AppThemeBinding Light=icon_deselect_light.png, Dark=icon_deselect_dark.png}"
                             Command="{Binding ClearSelectionCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Clear selection"
                             ToolTipProperties.Text="Clear selection" />
                <ImageButton Source="{AppThemeBinding Light=icon_delete_light.png, Dark=icon_delete_dark.png}"
                             Command="{Binding DeleteSelectedCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Delete selected books"
                             ToolTipProperties.Text="Delete" />
                <ImageButton Source="{AppThemeBinding Light=icon_close_light.png, Dark=icon_close_dark.png}"
                             Command="{Binding ExitSelectionModeCommand}"
                             Style="{StaticResource TopBarIconButton}"
                             SemanticProperties.Description="Cancel selection"
                             ToolTipProperties.Text="Cancel" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Search + sort -->
        <Grid Grid.Row="1" ColumnDefinitions="{OnIdiom Phone='*', Default='*,Auto'}" RowDefinitions="{OnIdiom Phone='Auto,Auto', Default='Auto'}" ColumnSpacing="8">
            <SearchBar Placeholder="Search by title or author"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       CancelButtonColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       HorizontalOptions="Fill" />
            <Picker Grid.Column="{OnIdiom Phone=0, Default=1}"
                    Grid.Row="{OnIdiom Phone=1, Default=0}"
                    Title="Sort library"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SortOption, Mode=TwoWay}"
                    WidthRequest="{OnIdiom Phone=-1, Default=140}"
                    HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                    VerticalOptions="Center" />
        </Grid>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{AppThemeBinding Light={StaticResource LibraryErrorLight}, Dark={StaticResource LibraryErrorDark}}"
               IsVisible="{Binding HasError}"
               LineBreakMode="WordWrap" />

        <!-- Card grid -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView x:Name="BooksCollection"
                            ItemsSource="{Binding VisibleBooks}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="BooksLayout"
                                     Orientation="Vertical"
                                     Span="1"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryBookItem">
                        <Border Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                                Background="{AppThemeBinding Light={StaticResource LibraryCoverLight}, Dark={StaticResource LibraryCoverDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="8"
                                HeightRequest="180">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource LibrarySelectionStroke}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=ViewModel.OpenDetailsCommand, x:DataType=views:LibraryPage}"
                                                      CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image Source="{Binding CoverPath}"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"
                                       SemanticProperties.Description="{Binding Title}" />
                                <Border HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="6"
                                        Padding="0"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11"
                                        Background="{StaticResource LibraryAccent}"
                                        IsVisible="{Binding Source={x:Reference Page}, Path=ViewModel.IsSelectionMode, x:DataType=views:LibraryPage}">
                                    <Label Text="✓"
                                           TextColor="White"
                                           FontSize="13"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           IsVisible="{Binding IsSelected}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Label Text="Your library is empty"
                               FontSize="16"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsLibraryEmpty}" />
                        <Label Text="Added books will appear here."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsLibraryEmpty}" />
                        <Label Text="No books match your search"
                               FontSize="16"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsSearchEmpty}" />
                        <Label Text="Try a different title or author."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding IsSearchEmpty}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Import progress overlay -->
        <Grid Grid.RowSpan="4"
              Background="#99000000"
              IsVisible="{Binding IsImporting}"
              ZIndex="10"
              Padding="16">
            <Border Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource LibraryCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,64" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2"
                                             HorizontalOptions="Fill">
                            <Label Text="Adding books"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding ImportStage}"
                                   TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   HeightRequest="18" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding ImportProgressPercent}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource LibraryAccent}"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding ImportProgress}"
                                 ProgressColor="{StaticResource LibraryAccent}"
                                 Background="{AppThemeBinding Light={StaticResource LibraryCardStrokeLight}, Dark={StaticResource LibraryCardStrokeDark}}"
                                 HeightRequest="6" />
                    <Label Text="{Binding ImportCurrentItem}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           HeightRequest="16" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding ImportProgressSummary}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource LibraryMutedTextLight}, Dark={StaticResource LibraryMutedTextDark}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Cancel"
                                Command="{Binding CancelImportCommand}"
                                Background="#A83A3A"
                                TextColor="White"
                                Padding="12,6" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
