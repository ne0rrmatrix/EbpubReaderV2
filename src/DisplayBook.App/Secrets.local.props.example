<Project>
	<!--
	Copy this file to Secrets.local.props (same folder) and fill in the real value.
	Secrets.local.props is gitignored — it never gets committed. This file (the
	.example template) is the only one tracked in git.

	FirebaseWebApiKeyEncoded supplies the Firebase Web API key for iOS/MacCatalyst
	builds, base64-encoded (see FirebaseOptions.cs for why it's base64 and why that's
	obfuscation, not real secrecy). It is baked into the compiled assembly at build
	time via <AssemblyMetadata>, which works on real iOS/MacCatalyst devices where a
	runtime environment variable would not (Xcode/simulator launches don't inherit
	your shell's env). Windows/Android continue to read MY_APP_SECRET from the
	environment at runtime instead; this file has no effect on those platforms.

	To (re)generate the encoded value from the raw key:
		echo -n "<raw-key>" | base64
	-->
	<PropertyGroup>
		<FirebaseWebApiKeyEncoded></FirebaseWebApiKeyEncoded>
	</PropertyGroup>
</Project>
