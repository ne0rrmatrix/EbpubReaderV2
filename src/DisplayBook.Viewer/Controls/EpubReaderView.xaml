<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewer="clr-namespace:DisplayBook.Viewer.Controls"
             x:Class="DisplayBook.Viewer.Controls.EpubReaderView"
             Background="Black">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid>
        <viewer:ReaderWebView x:Name="ReaderWebView"
                              AutomationId="EpubReaderWebView"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              Navigating="OnWebViewNavigating"
                              Navigated="OnWebViewNavigated" />
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="Black"
              InputTransparent="True">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16">
                <Image x:Name="LoadingCoverImage"
                       WidthRequest="220"
                       MaximumHeightRequest="320"
                       Aspect="AspectFit" />
                <Label x:Name="LoadingLabel"
                       Text="Opening publication…"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        <Grid x:Name="DefinitionOverlay"
              BackgroundColor="#80000000"
              IsVisible="False"
              VerticalOptions="End">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDefinitionScrimTapped" />
            </Grid.GestureRecognizers>
            <Border BackgroundColor="#F5F0E6"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,0,0,0"
                    VerticalOptions="End"
                    MaximumHeightRequest="320">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16,16,0,0" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <!-- Swallows taps on the card itself so they don't fall through to the scrim's dismiss handler. -->
                    <TapGestureRecognizer Tapped="OnDefinitionCardTapped" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Label x:Name="DefinitionWordLabel"
                           Grid.Row="0"
                           TextColor="#2C241B"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <ScrollView Grid.Row="1">
                        <Label x:Name="DefinitionTextLabel"
                               TextColor="#2C241B"
                               FontSize="15"
                               LineBreakMode="WordWrap" />
                    </ScrollView>
                    <Button Grid.Row="2"
                            Text="Close"
                            HorizontalOptions="End"
                            Clicked="OnDefinitionCloseClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>
