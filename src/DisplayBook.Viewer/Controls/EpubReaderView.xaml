<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewer="clr-namespace:DisplayBook.Viewer.Controls"
             x:Class="DisplayBook.Viewer.Controls.EpubReaderView"
             Background="Black">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid>
        <viewer:ReaderWebView x:Name="ReaderWebView"
                              AutomationId="EpubReaderWebView"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              Navigating="OnWebViewNavigating"
                              Navigated="OnWebViewNavigated" />
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="Black"
              InputTransparent="True">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16">
                <Image x:Name="LoadingCoverImage"
                       WidthRequest="220"
                       MaximumHeightRequest="320"
                       Aspect="AspectFit" />
                <Label x:Name="LoadingLabel"
                       Text="Opening publication…"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>
