{
	// Editor-only config for the one hand-written JS file in this repo, the WebView EPUB
	// reader at src/DisplayBook.Viewer/Resources/Raw/DisplayBookViewer/EpubText.js. It
	// type-checks that file from its JSDoc annotations, so the reader's JS gets the same
	// "does this member exist / can this be null" feedback the C# side gets from the
	// compiler. Nothing here participates in the MAUI build and no JS is emitted -- the
	// file ships to the WebView exactly as written.
	//
	// It lives at the repo root rather than next to EpubText.js because both csproj files
	// glob `Resources\Raw\**` as MauiAsset, which would package a sibling config into every
	// platform's app bundle.
	//
	// noImplicitAny stays off deliberately: annotating every local callback parameter would
	// be churn across code that already works. strictNullChecks is on because it catches the
	// failure this codebase actually hits -- contentDocument/querySelector returning null
	// after the WebView's content process is reclaimed or the frame is reloaded.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"checkJs": true,
		"strict": false,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noEmit": true
	},
	"include": ["src/DisplayBook.Viewer/Resources/Raw/DisplayBookViewer/**/*.js"]
}
